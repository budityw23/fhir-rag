{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose ps)",
      "Bash(docker compose build app)",
      "Bash(docker compose up -d app)",
      "Bash(docker compose up -d --force-recreate app)",
      "Bash(docker compose logs *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker stats --no-stream *)",
      "Bash(docker exec fhir_rag-app-1 python -m pytest *)",
      "Bash(docker exec fhir_rag-app-1 md5sum *)",
      "Bash(docker exec fhir_rag-app-1 pip list *)",
      "Bash(docker cp tests fhir_rag-app-1:*)",
      "Bash(curl -s localhost:8000/*)",
      "Bash(curl -sI localhost:8000/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-tree *)"
    ],
    "ask": [
      "Bash(docker compose down *)",
      "Bash(docker volume rm *)",
      "Bash(git push *)"
    ]
  }
}
